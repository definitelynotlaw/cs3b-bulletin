Options -MultiViews
RewriteEngine On

# Public problem-report URL maps to the existing FormSubmit page.
RewriteRule ^report-a-problem/?$ contact.php [L]

# Preserve the app's hyphenated URLs for underscore-named PHP files.
RewriteRule ^(announcement|archive|save|delete|submit)-([a-z-]+)/?$ $1_$2.php [L]

# Internally map extensionless requests to their PHP files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Redirect direct .php requests to extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[?\s]|$) [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,NE]
