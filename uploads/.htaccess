# Uploaded content is untrusted and must not be handled as executable code.
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .cgi .pl .py .sh .jpg .jpeg .png .webp

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)(\.php[0-9]*|\.phtml|\.pht|\.phar|\.cgi|\.pl|\.py|\.sh)(\.|$)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)(\.php[0-9]*|\.phtml|\.pht|\.phar|\.cgi|\.pl|\.py|\.sh)(\.|$)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>